{
  "name": "workflow-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "seed": "node scripts/seed.ts",
    "service": "node server/main.ts",
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "npm run build && node server/main.ts --serve-dist",
    "test": "node --test 'test/**/*.test.ts'",
    "check": "tsc && node --test 'test/**/*.test.ts' && vite build"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright-core": "1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
