#!/usr/bin/env python3
"""Edit the concrete routine schedule, and commit and push each change."""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from collections.abc import Callable
from pathlib import Path
from typing import Any

import dispatch


def next_id(rows: list[dict[str, Any]], prefix: str) -> str:
    numbers = []
    for row in rows:
        match = re.fullmatch(rf"{re.escape(prefix)}(\d+)", str(row.get("id", "")))
        if match:
            numbers.append(int(match.group(1)))
    return f"{prefix}{max(numbers, default=0) + 1}"


def find_row(rows: list[dict[str, Any]], row_id: str, noun: str) -> dict[str, Any]:
    try:
        return next(row for row in rows if row.get("id") == row_id)
    except StopIteration as error:
        raise dispatch.DispatchError(f"unknown {noun} id: {row_id}") from error


def mutate(
    repo: Path,
    message: str,
    change: Callable[[dict[str, Any]], str],
) -> str:
    env = dispatch.git_environment()
    status = subprocess.run(
        ["git", "status", "--porcelain"], cwd=repo, env=env, text=True, capture_output=True
    )
    if status.returncode:
        raise dispatch.DispatchError(f"git status failed: {(status.stderr or status.stdout).strip()[:300]}")
    if status.stdout.strip():
        raise dispatch.DispatchError("schedule clone has uncommitted changes; refusing to overwrite them")
    dispatch.git(repo, "pull", "--rebase", env=env)
    path = repo / "schedule.json"
    schedule = dispatch.load_schedule(path)
    changed_id = change(schedule)
    dispatch.atomic_write(path, schedule)
    dispatch.load_schedule(path)
    dispatch.commit(repo, message.format(id=changed_id), env)
    dispatch.git(repo, "push", "origin", "HEAD:main", env=env)
    return changed_id


def show(repo: Path) -> None:
    env = dispatch.git_environment()
    dispatch.git(repo, "pull", "--rebase", env=env)
    schedule = dispatch.load_schedule(repo / "schedule.json")
    print(json.dumps(schedule, ensure_ascii=False, indent=2))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog=(
            "Every mutating command validates schedule.json, changes only that file, "
            "then commits and pushes it. Times must be ISO-8601 with a timezone."
        ),
    )
    parser.add_argument("--repo", type=Path, default=dispatch.DEFAULT_REPO, help=argparse.SUPPRESS)
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("show", help="pull and print schedule.json")
    subparsers.add_parser("now", help="print the current UTC time")

    add_request = subparsers.add_parser("add-request", help="add the natural-language request")
    add_request.add_argument("--text", required=True)
    add_request.add_argument("--until", required=True)
    add_request.add_argument("--said-at", help="default: current UTC time")
    add_request.add_argument("--by", default="developer")

    add_fire = subparsers.add_parser("add-fire", help="add one concrete routine fire")
    add_fire.add_argument("--from", dest="request_id", required=True)
    add_fire.add_argument("--at", required=True)
    add_fire.add_argument("--routine", required=True)

    add_decide = subparsers.add_parser("add-decide", help="add one concrete Front decision")
    add_decide.add_argument("--from", dest="request_id", required=True)
    add_decide.add_argument("--at", required=True)
    add_decide.add_argument("--ask", required=True)

    move = subparsers.add_parser("move", help="move an unfired event")
    move.add_argument("event_id")
    move.add_argument("--at", required=True)

    remove = subparsers.add_parser("remove", help="remove an unfired event")
    remove.add_argument("event_id")

    set_until = subparsers.add_parser("set-until", help="shorten or extend a request's hard guard")
    set_until.add_argument("request_id")
    set_until.add_argument("--until", required=True)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    repo = args.repo.resolve()
    try:
        if args.command == "show":
            show(repo)
            return 0
        if args.command == "now":
            print(dispatch.format_time(dispatch.utc_now()))
            return 0
        if args.command == "add-request":
            said_at = args.said_at or dispatch.format_time(dispatch.utc_now())
            dispatch.parse_time(said_at, "--said-at")
            dispatch.parse_time(args.until, "--until")

            def add_request(schedule: dict[str, Any]) -> str:
                request_id = next_id(schedule["requests"], "r")
                schedule["requests"].append(
                    {"id": request_id, "said_at": said_at, "by": args.by, "until": args.until, "text": args.text}
                )
                return request_id

            changed_id = mutate(repo, "Add schedule request {id}", add_request)
        elif args.command in {"add-fire", "add-decide"}:
            at = dispatch.parse_time(args.at, "--at")

            def add_event(schedule: dict[str, Any]) -> str:
                request = find_row(schedule["requests"], args.request_id, "request")
                until = dispatch.parse_time(request["until"], f"request {args.request_id} until")
                if at > until:
                    raise dispatch.DispatchError("event time is after its request's until guard")
                event_id = next_id(schedule["events"], "e")
                event: dict[str, Any] = {
                    "id": event_id,
                    "at": dispatch.format_time(at),
                    "kind": "fire" if args.command == "add-fire" else "decide",
                    "from": args.request_id,
                    "fired_at": None,
                }
                if args.command == "add-fire":
                    event["routine"] = args.routine
                else:
                    event["ask"] = args.ask
                schedule["events"].append(event)
                return event_id

            changed_id = mutate(repo, f"Add {args.command[4:]} schedule event {{id}}", add_event)
        elif args.command == "move":
            at = dispatch.parse_time(args.at, "--at")

            def move_event(schedule: dict[str, Any]) -> str:
                event = find_row(schedule["events"], args.event_id, "event")
                if event["fired_at"] is not None:
                    raise dispatch.DispatchError("cannot move an event which has already fired")
                request = find_row(schedule["requests"], event["from"], "request")
                if at > dispatch.parse_time(request["until"], f"request {request['id']} until"):
                    raise dispatch.DispatchError("event time is after its request's until guard")
                event["at"] = dispatch.format_time(at)
                return args.event_id

            changed_id = mutate(repo, "Move schedule event {id}", move_event)
        elif args.command == "remove":

            def remove_event(schedule: dict[str, Any]) -> str:
                event = find_row(schedule["events"], args.event_id, "event")
                if event["fired_at"] is not None:
                    raise dispatch.DispatchError("cannot remove an event which has already fired")
                schedule["events"].remove(event)
                return args.event_id

            changed_id = mutate(repo, "Remove schedule event {id}", remove_event)
        else:
            dispatch.parse_time(args.until, "--until")

            def update_until(schedule: dict[str, Any]) -> str:
                request = find_row(schedule["requests"], args.request_id, "request")
                request["until"] = dispatch.format_time(dispatch.parse_time(args.until, "--until"))
                return args.request_id

            changed_id = mutate(repo, "Set schedule request {id} until", update_until)
        print(changed_id)
        return 0
    except dispatch.DispatchError as error:
        print(f"rtschedule: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
