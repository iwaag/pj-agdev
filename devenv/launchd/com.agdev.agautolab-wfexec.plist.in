<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agdev.agautolab-wfexec</string>
  <!-- autolab as the executor of workflow runs requested through agdevworld
       (workflow_editor p4, agautolab.wfexec). Settings: agautolab/.local/wfexec.toml
       (wfe = the agdev area's launcher, .local/agdev/bin/wfe). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__PROJECTS_ROOT__/pj-agdev/agautolab/agent/wfexec.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECTS_ROOT__/pj-agdev/agautolab</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__PROJECTS_ROOT__/pj-agdev/agautolab/.local/out/wfexec.log</string>
  <key>StandardErrorPath</key><string>__PROJECTS_ROOT__/pj-agdev/agautolab/.local/out/wfexec.log</string>
</dict>
</plist>
