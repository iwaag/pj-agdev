<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agdev.agentroom</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>__PROJECTS_ROOT__/pj-agdev/agdevworld/agentroom/service/serve.sh</string></array>
  <key>WorkingDirectory</key><string>__PROJECTS_ROOT__/pj-agdev/agdevworld/agentroom</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- `uv` is what serve.sh execs; without an explicit PATH launchd's own
         does not carry it and the job dies on every restart. -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- Since workflow_editor p15 the relay serves /budget and /cost only and
         holds no credential: the Zulip mirror and the Developer's write
         credential left with the Front Desk. -->
    <!-- `instance=<project root>`: the pre-WFE agents whose ag.agent-run.v1
         records `/cost` reads as history for the workflow editor's Usage
         view (retire_old_ui p1). Host files only, never Zulip. -->
    <key>AGENTROOM_AGENT_ROOTS</key><string>front-agstudio1=__PROJECTS_ROOT__/pj-agdev/agfront,arxivsage-agstudio1=__PROJECTS_ROOT__/arxivsage,agecho-agstudio1=__PROJECTS_ROOT__/agecho</string>
    <!-- The budget read (`gauge_panel` ex1; the Usage view's windows since
         retire_old_ui p1): the CLIs' own binaries, by
         absolute path because `~/.local/bin` is not on the PATH above. The
         relay only ever *reads* through them; it never touches a credential
         store. the Claude token comes from the
         Keychain item `Claude Code-credentials` (read-only, `security -w`)
         and only then from `~/.claude/.credentials.json`, both defaults; `AGENTROOM_BUDGET_SECONDS` (60) is
         how often a vendor is asked, whatever the page polls. -->
    <key>AGENTROOM_CODEX_BIN</key><string>__HOME__/.local/bin/codex</string>
    <key>AGENTROOM_AGY_BIN</key><string>__HOME__/.local/bin/agy</string>
    <!-- Observer's watchdog left the relay in observer p3 (agobserver.watchdog,
         com.agdev.agobserver-watchdog). -->
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__PROJECTS_ROOT__/pj-agdev/agdevworld/agentroom/.local/out/agentroom.log</string>
  <key>StandardErrorPath</key><string>__PROJECTS_ROOT__/pj-agdev/agdevworld/agentroom/.local/out/agentroom.log</string>
</dict>
</plist>
