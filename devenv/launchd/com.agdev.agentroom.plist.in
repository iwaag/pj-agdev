<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agdev.agentroom</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>__PROJECTS_ROOT__/pj-agdev/agdevworld/agentroom/service/serve.sh</string></array>
  <key>WorkingDirectory</key><string>__PROJECTS_ROOT__/pj-agdev/agdevworld/agentroom</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- `uv` is what serve.sh execs; without an explicit PATH launchd's own
         does not carry it and the job dies on every restart. -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- Paths to ignored credentials files. Never the values themselves. -->
    <key>AGENTROOM_ZULIP_ENV</key><string>__PROJECTS_ROOT__/pj-agdev/.local/zulip/developer.env</string>
    <key>OPSROOM_ZULIP_ENV</key><string>__PROJECTS_ROOT__/pj-agdev/.local/zulip/opsroom.env</string>
    <!-- The relay's own default; stated here because this is where it is tuned. -->
    <key>AGENTROOM_STALLED_SECONDS</key><string>900</string>
    <!-- The chat's own credential: the *Developer*, because a post from the
         GUI is the Developer speaking and starts a paid Front run. Separate
         from the read variables on purpose, and nothing falls back to it. -->
    <key>AGENTROOM_CHAT_ZULIP_ENV</key><string>__PROJECTS_ROOT__/pj-agdev/.local/zulip/developer.env</string>
    <!-- `instance=<project root>` for the in-flight signal: the relay looks
         at this host's own `.local/topics` and `.local/agent` trees, never at
         Zulip, which is why the view may poll it at a few seconds
         (`operation_room` p3). An instance missing here reports `unknown`. -->
    <key>AGENTROOM_AGENT_ROOTS</key><string>front-agstudio1=__PROJECTS_ROOT__/pj-agdev/agfront,autolab-agstudio1=__PROJECTS_ROOT__/pj-agdev/agautolab,agforge-agstudio1=__PROJECTS_ROOT__/pj-agdev/agforge,arxivsage-agstudio1=__PROJECTS_ROOT__/arxivsage,agecho-agstudio1=__PROJECTS_ROOT__/agecho</string>
    <!-- The routine dispatcher's schedule, read as a local file: the routine
         GUI on :8093 serves the same clone but answers no CORS header, so a
         browser cannot read it (`operation_room` p3). -->
    <key>AGENTROOM_SCHEDULE_JSON</key><string>__PROJECTS_ROOT__/pj-agdev/.local/rtschedule/schedule.json</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__PROJECTS_ROOT__/pj-agdev/agdevworld/agentroom/.local/out/agentroom.log</string>
  <key>StandardErrorPath</key><string>__PROJECTS_ROOT__/pj-agdev/agdevworld/agentroom/.local/out/agentroom.log</string>
</dict>
</plist>
