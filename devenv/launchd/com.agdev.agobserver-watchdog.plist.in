<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The watchdog of Observer and the executor (observer p3), relocated
       from the agentroom relay: workflow-health.json and the executor
       heartbeat every 30 s; owners told by DM on a change.
       -->
  <key>Label</key><string>com.agdev.agobserver-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__PROJECTS_ROOT__/pj-agdev/agobserver/service/watchdog.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECTS_ROOT__/pj-agdev/agobserver</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__PROJECTS_ROOT__/pj-agdev/agobserver/.local/out/watchdog.log</string>
  <key>StandardErrorPath</key><string>__PROJECTS_ROOT__/pj-agdev/agobserver/.local/out/watchdog.log</string>
</dict>
</plist>
